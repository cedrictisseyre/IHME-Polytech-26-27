{
  "name": "diagnostic-polytech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["backend", "frontend"],
  "engines": { "node": ">=24" },
  "scripts": {
    "configure": "node backend/scripts/configure.mjs",
    "dev:api": "node --watch --env-file-if-exists=.env backend/src/server.js",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "node --env-file-if-exists=.env backend/src/server.js",
    "test": "node --test backend/test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test backend/test/integration/*.test.js",
    "purge": "node --env-file-if-exists=.env backend/scripts/purge.mjs"
  }
}
